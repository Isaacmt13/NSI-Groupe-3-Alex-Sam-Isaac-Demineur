from p5 import * 

class Perso1:
    def __init__(self, posX, posY, taille, couleur, couleur1, couleur2, couleur3, couleur4):
        self.posX = posX
        self.posY = posY
        self.taille = taille
        self.couleur = couleur
        self.couleur1 = couleur1
        self.couleur2 = couleur2
        self.couleur3 = couleur3
        self.couleur4 = couleur4
        
    def dessine(self):
        translate(self.posX, self.posY)  # Applique la translation à la position du personnage
        scale(self.taille)  # Applique l'échelle
        fill(self.couleur4) 
        strokeWeight(4)
        ellipse(350, 350, 30, 60) #bras
        ellipse(430, 350, 30, 60)
        fill(self.couleur1)
        rect(345,370,90,20) #corps
        fill(self.couleur2)
        ellipse(390,370,60,55) #tête
        

        
def setup():
    createCanvas(800, 600)  # Définir la taille de la fenêtre    
    global perso1  # Déclare la variable personnage comme globale
    perso1 = Perso1(0,0, 1, (124, 142, 80), (88, 60, 40), (124, 142, 80), (255), (124, 142, 80))  # Crée un personnage 

def draw():
    background(255)  # Remplir l'arrière-plan en blanc
    perso1.dessine()# Dessine le personnage à sa nouvelle position
    
run()
