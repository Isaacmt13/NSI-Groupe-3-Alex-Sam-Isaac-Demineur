from p5 import * 

class Perso1:
    def __init__(self, posX, posY, taille, couleur, couleur1, couleur2, couleur3, couleur4, couleur5):
        self.posX = posX
        self.posY = posY
        self.taille = taille
        self.couleur = couleur
        self.couleur1 = couleur1
        self.couleur2 = couleur2
        self.couleur3 = couleur3
        self.couleur4 = couleur4
        self.couleur5 = couleur5
        
    def dessine(self):
        translate(self.posX, self.posY)  # Applique la translation à la position du personnage
        scale(self.taille)  # Applique l'échelle
        stroke(self.couleur)
        fill(self.couleur4) 
        strokeWeight(4)
        ellipse(350, 350, 30, 60) #bras
        ellipse(430, 350, 30, 60)
        fill(self.couleur1)
        rect(345,370,90,20) #corps
        fill(self.couleur2)
        ellipse(390,370,60,55) #tête
        fill(self.couleur3)
        ellipse(390,350,40,10) #yeux
        line(370,365,370,365)
        stroke(self.couleur5)
        fill(self.couleur4)
        ellipse(390,370,40,35)
        line(340,334,360,334) 
        line(440,334,420,334)
        
class Sabre:
    def __init__(self, posX, posY, taille, couleur, couleur1, couleur2):
        self.posX = posX
        self.posY = posY
        self.taille = taille
        self.couleur = couleur
        self.couleur1 = couleur1
        self.couleur2 = couleur2
        
    def dessin(self):
        translate(self.posX, self.posY)  # Applique la translation à la position du personnage
        scale(self.taille)  # Applique l'échelle
        stroke(self.couleur)
        fill(self.couleur)
        rect(100,100,5,10)
        fill(self.couleur1)
        rect(100,50,5,50)
        
        
        
        
        
def setup():
    size(800, 600)  # Définir la taille de la fenêtre    
    global perso1  # Déclare la variable personnage comme globale
    perso1 = Perso1(0,0, 1, (0), (85,82,80), (0), (255), (0), (255,0,0))  # Crée un personnage 
    global sabre
    sabre = Sabre(245,210, 1, (0), (255,255,102), (85,82,80))
    
def draw():
    background(255)  # Remplir l'arrière-plan en blanc
    perso1.dessine()# Dessine le personnage à sa nouvelle position
    sabre.dessin()
    
run()
